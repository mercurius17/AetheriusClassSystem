{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "shared/**/*",
    "server/**/*",
    "client/**/*",
    "tests/**/*",
    "vendor/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "ui"
  ]
}
